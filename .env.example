# Google OAuth Client ID (tipo "Web application"). Necesario para iniciar sesión.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Email de la cuenta de Google que será owner del tenant inicial tras migrar.
DEFAULT_OWNER_EMAIL=

# Opcional. Emails separados por coma que serán superadministradores del
# sistema (panel /admin). Se sincronizan al arrancar (flag is_superadmin).
ADMIN_EMAILS=

# Puerto interno del backend (el frontend proxea /api).
PORT=4000

# Notificaciones push. Generar con:
# cd backend && npx web-push generate-vapid-keys --json
# La clave privada solo debe configurarse en el backend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
